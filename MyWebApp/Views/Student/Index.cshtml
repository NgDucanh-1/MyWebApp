@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}
@model IEnumerable<MyWebApp.Models.Student>

<div class="container-fluid px-4">
    <h1 class="mt-4">Student List</h1>
    <p>
        <a asp-action="Create" class="btn btn-primary">Create Student</a>
    </p>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Ngành</th>
                <th>Giới tính</th>
                <th>Hệ ĐT</th>
                <th>Địa chỉ</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.DateOfBirth.ToString("dd/MM/yyyy")</td>
                    <td>@item.Branch</td>
                    <td>@item.Gender</td>
                    <td>@(item.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                    <td>@item.Address</td>
                    <td>@item.Email</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        var table = document.querySelector("table");
        if (table) {
            table.onclick = function onTableClick() {
                table.style.backgroundColor = "yellow";
            };
        }
    </script>
}
