@model Student
@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="container mt-4">
    <h2>Thêm sinh viên mới</h2>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-route="StudentAddPost" method="post" enctype="multipart/form-data" class="mt-3">
        <div class="form-group row mb-3">
            <label asp-for="Name" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ và tên">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Email" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email (@gmail.com)">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Password" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Score" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Score" type="number" step="0.1" class="form-control" placeholder="Điểm (0.0 - 10.0)">
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <select asp-for="Branch" class="form-select" asp-items="Html.GetEnumSelectList<Branch>()">
                    <option value="">-- Chọn ngành --</option>
                </select>
                <span asp-validation-for="Branch" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="DateOfBorth" type="date" class="form-control">
                <span asp-validation-for="DateOfBorth" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Gender" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                @if (ViewBag.AllGenders != null)
                {
                    @foreach (var gender in ViewBag.AllGenders)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Gender" value="@gender" id="Gender_@gender" />
                            <label class="form-check-label" for="Gender_@gender">@gender</label>
                        </div>
                    }
                }
                <div><span asp-validation-for="Gender" class="text-danger"></span></div>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10 d-flex align-items-center">
                <input type="checkbox" class="form-check-input mt-0" asp-for="IsRegular">
                <span class="ms-2">Chính quy</span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Address" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label for="avatar" class="col-sm-2 col-form-label">Ảnh đại diện</label>
            <div class="col-sm-10">
                <input type="file" name="avatar" id="avatar" accept="image/*" class="form-control">
            </div>
        </div>

        <div class="form-group row mt-4">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Thêm mới</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}